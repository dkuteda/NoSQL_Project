@model NoSQL_Project.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    body {
        background: radial-gradient(circle at center, #0a0f1c, #000);
        color: #00ffcc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        text-align: center;
        padding-top: 80px;
    }

    h2 {
        font-size: 2.5rem;
        text-shadow: 0 0 15px #00ffcc;
        margin-bottom: 30px;
    }

    form {
        background: rgba(0, 20, 40, 0.9);
        border: 2px solid #00ffcc;
        border-radius: 12px;
        padding: 30px;
        width: 400px;
        margin: auto;
        box-shadow: 0 0 25px #00ffcc;
        animation: pulse 2s infinite;
    }

    label {
        font-size: 1.2rem;
        text-shadow: 0 0 8px #00ffcc;
    }

    input {
        width: 100%;
        padding: 12px;
        margin-top: 10px;
        border: 1px solid #00ffcc;
        border-radius: 8px;
        background: #0a0f1c;
        color: #00ffcc;
        font-size: 1rem;
        box-shadow: inset 0 0 10px #00ffcc;
    }

    button {
        margin-top: 20px;
        padding: 12px 25px;
        background: #00ffcc;
        color: #000;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 0 15px #00ffcc;
    }

    button:hover {
        background: #000;
        color: #00ffcc;
        border: 1px solid #00ffcc;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 15px #00ffcc; }
        50% { box-shadow: 0 0 35px #00ffcc; }
        100% { box-shadow: 0 0 15px #00ffcc; }
    }
</style>

<h2>Forgot Password</h2>

<form asp-action="ForgotPassword" method="get">
    <div class="form-group">
        <label for="email">Enter your email address:</label>
        <input type="email" name="email" id="email" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@if (Model?.Employee != null)
{
    <script>
        window.location.href = '@Url.Action("ResetPassword", new { email = Model.Employee.Email })';
    </script>
}
