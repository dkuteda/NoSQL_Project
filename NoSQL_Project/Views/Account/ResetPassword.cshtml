@model NoSQL_Project.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<h2>Hello @Model.Employee.FirstName @Model.Employee.LastName 👋🏻👋🏻 Let's Reset Your Password.</h2>

<form asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Employee.EmployeeId" />
    <input type="hidden" asp-for="Employee.Email" />

    <div class="form-group">
        <label for="password">New Password:</label>
        <input type="password" name="Employee.Password" id="password" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="confirmPassword">Confirm New Password:</label>
        <input type="password" id="confirmPassword" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Reset Password</button>
</form>

@section Scripts {
    <script>
        document.querySelector("form").addEventListener("submit", function (e) {
            var password = document.getElementById("password").value;
            var confirmPassword = document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alert("Passwords do not match. Please try again.");
            }
        });
    </script>
}
