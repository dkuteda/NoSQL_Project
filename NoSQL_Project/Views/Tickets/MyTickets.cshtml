@model NoSQL_Project.ViewModels.TicketViewModel

<div class="container py-4">

    <!-- Header -->
    <div class="bg-light p-4 rounded-3 mb-4 shadow-sm">
        <h1 class="display-6 fw-bold mb-3">My Tickets</h1>

        <!-- Search Bar -->
        <form class="d-flex gap-2 mb-2" method="get" action="/Tickets/Search">
            <input name="text" class="form-control" placeholder="Search by title or description..." />

            <select name="and" class="form-select w-auto">
                <option value="false">OR (Any word)</option>
                <option value="true">AND (All words)</option>
            </select>

            <button class="btn btn-dark">Search</button>
            <a href="/Tickets/Index" class="btn btn-outline-secondary">Reset</a>
        </form>

        <a href="@Url.Action("AddTicket", "Tickets")" class="btn btn-primary">
            Create a New Ticket
        </a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
        </div>
    }

    <!-- Ticket Cards -->
    @if (Model.TicketList != null && Model.TicketList.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var ticket in Model.TicketList)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body position-relative">

                            <div class="d-flex justify-content-between">
                                <h5 class="text-primary">@ticket.Title</h5>

                                @if (ticket.Status == NoSQL_Project.Enums.TicketStatus.open)
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else if (ticket.Status == NoSQL_Project.Enums.TicketStatus.resolved)
                                {
                                    <span class="badge bg-warning">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                            </div>

                            <p class="small text-muted mb-1">
                                Created: @ticket.CreatedAt.ToString("dd MMM yyyy")
                            </p>

                            <p class="text-truncate">@ticket.Description</p>

                            <a href="@Url.Action("TicketDetails", "Tickets", new{ id=ticket.TicketId})" class="stretched-link"></a>
                        </div>

                        <div class="card-footer bg-white border-0 d-flex justify-content-between">
                            <a href="@Url.Action("UpdateTicket", "Tickets", new { id = ticket.TicketId })" class="btn btn-outline-primary btn-sm">
                                Edit
                            </a>

                            <a href="@Url.Action("EscalateTicket", "Tickets", new { id = ticket.TicketId })" class="btn btn-outline-dark btn-sm">
                                Escalate
                            </a>

                            <a href="@Url.Action("CloseTicket", "Tickets", new { id = ticket.TicketId }, null)" class="btn btn-outline-danger btn-sm">
                                Close
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <h5>No tickets found</h5>
            <p>Try another search or create a new ticket.</p>
        </div>
    }
</div>
