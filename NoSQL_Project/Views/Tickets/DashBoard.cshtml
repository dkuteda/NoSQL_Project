@model NoSQL_Project.ViewModels.DashboardViewModel
@using NoSQL_Project.Models

<div class="container py-4">

    <h2 class="fw-bold mb-4 text-primary">Dashboard</h2>

    @* STATS SECTION (ALWAYS VISIBLE, DOES NOT CHANGE) *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Open Tickets</h6>
                <h3 class="fw-bold text-warning">@Model.OpenPercent%</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Resolved Tickets</h6>
                <h3 class="fw-bold text-success">@Model.ResolvedPercent%</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Closed Tickets</h6>
                <h3 class="fw-bold text-danger">@Model.ClosedPercent%</h3>
            </div>
        </div>
    </div>

    @* TICKET TABLE *@
    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Recent Tickets</h5>
            <a href="@Url.Action("Index", "Tickets")" class="btn btn-outline-primary btn-sm">View All</a>
        </div>

        @if (Model.TicketList != null && Model.TicketList.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Created By</th>
                        <th>Created At</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="ticketTable">
                    @foreach (var ticket in Model.TicketList)
                    {
                        <tr>
                            <td>@ticket.Title</td>
                            <td>
                                <span class="badge bg-@(
                                    ticket.Status == NoSQL_Project.Enums.TicketStatus.open ? "warning" :
                                    ticket.Status == NoSQL_Project.Enums.TicketStatus.resolved ? "success" : "secondary"
                                )">@ticket.Status</span>
                            </td>
                            <td>@ticket.Priority</td>
                            <td>@ticket.CreatedBy?.Firstname</td>
                            <td>@ticket.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a href="@Url.Action("TicketDetails", "Tickets", new { id = ticket.TicketId })"
                                   class="btn btn-sm btn-outline-info">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- LOAD MORE BUTTON -->
            <div class="text-center mt-3">
                <button id="loadMoreBtn" class="btn btn-outline-secondary btn-sm">Load More</button>
            </div>
        }
        else
        {
            <p class="text-center text-muted mb-0 py-3">No tickets found.</p>
        }
    </div>
</div>

@* LOAD MORE SCRIPT *@
<script>
    let visible = 5; // Show first 5
    const rows = document.querySelectorAll("#ticketTable tr");
    const btn = document.getElementById("loadMoreBtn");

    // Hide all except first 5
    rows.forEach((row, i) => {
        if (i >= visible) row.style.display = "none";
    });

    btn.addEventListener("click", () => {
        let count = 0;
        rows.forEach(row => {
            if (row.style.display === "none" && count < 5) {
                row.style.display = "";
                count++;
            }
        });

        // Hide button if all rows are visible now
        if ([...rows].every(r => r.style.display === "")) {
            btn.style.display = "none";
        }
    });
</script>
