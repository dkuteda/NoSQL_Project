@model NoSQL_Project.ViewModels.DashboardViewModel

<div class="container py-4">
    <h2 class="fw-bold mb-4 text-primary">Dashboard</h2>

    <!-- 🔍 Search Bar -->
    <form class="d-flex gap-2 mb-4" method="get" action="/Tickets/Dashboard">
        <input name="text" value="@ViewBag.SearchText" class="form-control"
               placeholder="Search tickets by title or description..." />

        <select name="and" class="form-select w-auto">
            <option value="false">OR (Any word)</option>
            <option value="true">AND (All words)</option>
        </select>

        <button class="btn btn-dark">Search</button>
        <a href="/Tickets/Dashboard" class="btn btn-outline-secondary">Reset</a>
    </form>

    <!-- 📊 Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Open Tickets</h6>
                <h3 class="fw-bold text-warning">@Model.OpenPercent%</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Resolved Tickets</h6>
                <h3 class="fw-bold text-success">@Model.ResolvedPercent%</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <h6 class="text-muted mb-1">Closed Tickets</h6>
                <h3 class="fw-bold text-danger">@Model.ClosedPercent%</h3>
            </div>
        </div>
    </div>

    <!-- 🎫 Ticket List -->
    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Tickets</h5>
        </div>

        @if (Model.TicketList != null && Model.TicketList.Any())
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Created By</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var ticket in Model.TicketList)
                    {
                        <tr>
                            <td>@ticket.Title</td>

                            <td>
                                <span class="badge bg-@(
                                    ticket.Status == NoSQL_Project.Enums.TicketStatus.open ? "warning" :
                                    ticket.Status == NoSQL_Project.Enums.TicketStatus.resolved ? "success" : "secondary"
                                )">@ticket.Status</span>
                            </td>

                            <td>@ticket.Priority</td>
                            <td>@ticket.CreatedBy?.Firstname</td>
                            <td>@ticket.CreatedAt.ToString("MMM dd, yyyy")</td>

                            <td class="text-end">
                                <div class="btn-group btn-group-sm">

                                    <!-- View Button -->
                                    <a href="@Url.Action("TicketDetails", "Tickets", new { id = ticket.TicketId })"
                                       class="btn btn-outline-info">
                                        View
                                    </a>

                                    <!-- Edit Button -->
                                    <a href="@Url.Action("UpdateTicket", "Tickets", new { id = ticket.TicketId })"
                                       class="btn btn-outline-primary">
                                        Edit
                                    </a>

                                </div>
                            </td>
                            @if (Model.MayCloseTicket)
                            {
                                <td>
                                    <a href="@Url.Action("EscalateTicket", "Tickets", new { id = ticket.TicketId }, null)" class="btn btn-outline-dark btn-sm">
                                        Escalate
                                    </a>

                                    <a href="@Url.Action("CloseTicket", "Tickets", new { id = ticket.TicketId }, null)" class="btn btn-outline-danger btn-sm">
                                        Close
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Context.Request.Query.ContainsKey("more"))
            {
                <div class="text-center mt-3">
                    <a class="btn btn-outline-secondary" href="/Tickets/Dashboard?more=true">
                        Load More
                    </a>
                </div>
            }

        }
        else
        {
            <p class="text-center text-muted mb-0 py-3">No tickets found.</p>
        }
    </div>
</div>
