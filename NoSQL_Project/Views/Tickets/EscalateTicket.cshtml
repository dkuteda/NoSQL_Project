@model NoSQL_Project.ViewModels.EscalateViewModel

@{
    ViewData["Title"] = "Escalate Ticket";
}

<div class="container">
    <div class="form-container">
        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            </div>
        }

        <!-- Error Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="form-section">
            <h3 class="form-section-title">
                <i class="fas fa-user-circle"></i>Ticket Details
            </h3>

            <div class="ticket-details">
                <div class="col-md-6">
                    <dl>
                        <dt><i class="fas fa-user me-2"></i>Title:</dt>
                        <dd>@Model.Ticket.Title</dd>

                        <dt><i class="fas fa-user-tag me-2"></i>Description:</dt>
                        <dd>@Model.Ticket.Description</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">
                <i class="fas fa-user-circle"></i>Escalation Details
            </h3>

            <div class="ticket-details">
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt><i class="fas fa-map-marker-alt me-2"></i>Old priority:</dt>
                            <dd>@Model.Ticket.Priority</dd>

                            <dt><i class="fas fa-map-marker-alt me-2"></i>New priority:</dt>
                            <dd>@Model.NewPriority</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt><i class="fas fa-map-marker-alt me-2"></i>Old Deadline:</dt>
                            <dd>@Model.Ticket.Deadline</dd>

                            <dt><i class="fas fa-map-marker-alt me-2"></i>New deadline:</dt>
                            <dd>@Model.NewDeadline</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.NewDeadline == Model.Ticket.Deadline)
        {
            <h1>The priority is already at the maximum level.</h1>
        }
  
<form asp-controller="Tickets" asp-action="EscalateTicket" method="post" id="CloseForm">
    @Html.AntiForgeryToken()
            <input type="hidden" asp-for="@Model.Ticket.TicketId" />
            <input type="hidden" asp-for="@Model.Ticket.Title" />
            <input type="hidden" asp-for="@Model.Ticket.Description" />
            <input type="hidden" asp-for="@Model.Ticket.Status" />
            <input type="hidden" asp-for="@Model.Ticket.Priority" />
            <input type="hidden" asp-for="@Model.Ticket.Deadline" />
            <input type="hidden" asp-for="@Model.Ticket.CreatedBy" />
            <input type="hidden" asp-for="@Model.Ticket.CreatedAt" />
            <input type="hidden" asp-for="@Model.Ticket.TypeOfIncident" />
            <input type="hidden" asp-for="@Model.Ticket.ResolutionSteps" />

            <input type="hidden" asp-for="@Model.NewPriority" />
            <input type="hidden" asp-for="@Model.NewDeadline" />

    <div class="form-actions">
        <div class="btn-group-form">
            <button type="submit" id="escalateButton" class="btn btn-dark btn-lg">
                Confirm escalation
            </button>
            <a href="@Url.Action("Index", "Tickets")" class="btn btn-secondary btn-lg">
                <i class="fas fa-arrow-left me-2"></i>Cancel
            </a>
        </div>
    </div>
</form>
    </div>
</div>
}