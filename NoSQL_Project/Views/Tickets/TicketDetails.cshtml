@model NoSQL_Project.ViewModels.TicketViewModel;
@{
    ViewData["Title"] = "Ticket Details";
    Employee? loggedInEmployee = (Employee?)ViewData["LoggedInEmployee"];
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 d-flex align-items-center">
            <a href="javascript:history.back()" class="text-decoration-none me-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h5 class="mb-0">Ticket Details</h5>

            <!-- Error & Success Messages -->
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
                </div>
            }
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.SuccessMessage
                </div>
            }
        </div>

        <div class="card-body">
            <div class="mb-3">
                <div><strong>Requester:</strong> @Model.Ticket.CreatedBy.Firstname @Model.Ticket.CreatedBy.Lastname</div>
                <div><strong>Subject:</strong> @Model.Ticket.Title</div>
                <div><strong>Submitted:</strong> @Model.Ticket.CreatedAt.ToString("MMM d, yyyy")</div>
                <div><strong>Ticket ID:</strong> @Model.Ticket.TicketId</div>
                <div><strong>Ticket Status:</strong> <span class="badge bg-success">@Model.Ticket.Status</span></div>
                <div><strong>Description:</strong> @Model.Ticket.Description</div>
            </div>
            
            <div>
                @if(Model.Ticket.ResolutionSteps.Any())
                {
                    @foreach (var step in Model.Ticket.ResolutionSteps)
                    {
                        <div class="p-3 my-2 rounded bg-light border">
                            <div class="fw-bold text-primary">@step.PresentHandler.Firstname @step.PresentHandler.Lastname</div>
                            <div>@step.Action</div>
                            <div class="text-muted small mt-1">@step.DateCreated.ToString()</div>
                        </div>
                    }
                    @* If you are the latest handler you can search for a person to transfer to *@
                    @if (Model.IsAssignee)
                    {
                        <div class="card mt-4">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Transfer this Ticket</h6>
                                <small class="text-white">You are the current handler</small>
                            </div>

                            <div class="card-body">
                                <form method="get" action="@Url.Action("OnSearch")" class="mb-3">
                                    <input type="hidden" value="@Model.Ticket.TicketId" name="ticketId" />
                                    <div class="input-group">
                                        <input type="search" class="form-control" placeholder="Search employees by name or email" name="nameQuery" aria-label="Search transferees" />
                                        <button class="btn btn-primary" type="submit">
                                            <i class="bi bi-search me-1"></i> Search
                                        </button>
                                    </div>
                                </form>

                                @if (Model.PotentialTransferees.Count > 0)
                                {
                                    <div class="list-group">
                                        @foreach (var employee in Model.PotentialTransferees)
                                        {
                                            <div class="list-group-item d-flex gap-3 align-items-center">
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">@employee.FirstName @employee.LastName</div>
                                                    <div class="text-muted small">@employee.Email</div>
                                                </div>

                                                <div class="d-flex align-items-center">
                                                    <form asp-action="TransferTicket" asp-controller="Tickets" method="post" class="m-0">
                                                        <input type="hidden" value="@Model.Ticket.TicketId" name="ticketId" />
                                                        <input type="hidden" value="@employee.EmployeeId" name="employeeId" />
                                                        <input type="hidden" value="@employee.FirstName" name="firstName" />
                                                        <input type="hidden" value="@employee.LastName" name="lastName" />
                                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                                            <i class="bi bi-arrow-right-square me-1"></i> Transfer
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0" role="alert">
                                        No matching transferees found. Try a different search term.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-4 d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <div>You are not assigned to this ticket. You cannot transfer it to someone else.</div>
                        </div>
                    }
                }
                else
                {
                    @*You can only assign a ticket to yourself if you are a manager or a service desk employee AND there's no one assigned to it*@
                    if (Model.CanAssignToSelf)
                    {
                        <div>
                            <form asp-controller="Tickets" asp-action="AssignMyselfToTicket" method="post">
                                <input type="hidden" value="@Model.Ticket.TicketId" name="ticketId" />
                                <input type="hidden" value="@loggedInEmployee.EmployeeId" name="employeeId" />
                                <input type="hidden" value="@loggedInEmployee.FirstName" name="firstName" />
                                <input type="hidden" value="@loggedInEmployee.LastName" name="lastName" />
                                <button class="btn btn-primary m-1" type="submit">Assign myself to this ticket</button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
