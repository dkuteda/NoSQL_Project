@model NoSQL_Project.ViewModels.TicketViewModel;
@{
    ViewData["Title"] = "Ticket Details";
    Employee? loggedInEmployee = ViewData["LoggedInEmployee"] as Employee;
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 d-flex align-items-center">
            <a href="javascript:history.back()" class="text-decoration-none me-2">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h5 class="mb-0">Ticket Details</h5>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                </div>
            }

            <!-- Error Message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                </div>
            }
        </div>

        <div class="card-body">
            <div class="mb-3">
                <div><strong>Requester:</strong> @Model.Ticket.CreatedBy.Firstname @Model.Ticket.CreatedBy.Lastname</div>
                <div><strong>Subject:</strong> @Model.Ticket.Title</div>
                <div><strong>Submitted:</strong> @Model.Ticket.CreatedAt.ToString("MMM d, yyyy")</div>
                <div><strong>Ticket ID:</strong> @Model.Ticket.TicketId</div>
                <div><strong>Ticket Status:</strong> <span class="badge bg-success">@Model.Ticket.Status</span></div>
                <div><strong>Description:</strong> @Model.Ticket.Description</div>
            </div>
            
            <div>
                @if(Model.Ticket.ResolutionSteps.Any())
                {
                    @foreach (var step in Model.Ticket.ResolutionSteps)
                    {
                        <div class="p-3 my-2 rounded bg-light border">
                            <div class="fw-bold text-primary">@step.PresentHandler.Firstname @step.PresentHandler.Lastname</div>
                            <div>@step.Action</div>
                            <div class="text-muted small mt-1">@step.DateCreated.ToString()</div>
                        </div>
                    }
                    @*If you are not the latest handler and you are a service desk or a manager*@
                    @if(loggedInEmployee?.EmployeeId == Model.Ticket.ResolutionSteps.Last().PresentHandler.EmployeeId && loggedInEmployee.UserRole == NoSQL_Project.Enums.UserRole.service_desk_employee || loggedInEmployee.UserRole == NoSQL_Project.Enums.UserRole.manager)
                    {
                        <form class="mt-4" action="" method="post">
                            <div class="mb-3">
                                <textarea name="action" id="action" class="form-control" rows="3" placeholder="Type your response..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Add Response</button>
                        </form>

                        <form method="get" action="@Url.Action("OnSearch")">
                            <div class="input-group">
                                <input class="m-1" type="hidden" value="@Model.Ticket.TicketId" name="ticketId" id="nameQuery" />
                                <input type="text" class="form-control m-1" placeholder="Enter search term" name="nameQuery" id="nameQuery" />
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="submit">Search</button>
                                </div>
                            </div>
                        </form>
                        @if (Model.PotentialTransferees.Count > 0)
                        {
                            @foreach (var employee in Model.PotentialTransferees)
                            {
                                <div class="d-flex">
                                    <p>Transfer Ticket to @employee.FirstName @employee.LastName</p>
                                    <form asp-action="TransferTicket" asp-controller="Tickets" method="post">
                                        <input type="hidden" value="@Model.Ticket.TicketId" name="ticketId" />
                                        <input type="hidden" value="@employee.EmployeeId" name="employeeId" />
                                        <input type="hidden" value="@employee.FirstName" name="firstName" />
                                        <input type="hidden" value="@employee.LastName" name="lastName" />
                                        <button type="submit" class="btn btn-primary">Transfer Ticket</button>
                                    </form>
                                </div>
                            }
                        }
                    }
                    else{
                        <div class="alert alert-info mt-4">
                            You are not assigned to this ticket. You cannot add responses, nor transfer it.
                        </div>
                    }
                }
                else
                {
                    <div>
                        <form asp-controller="Tickets" asp-action="AssignMyselfToTicket" method="post">
                            <input type="hidden" value="@Model.Ticket.TicketId" name="ticketId" />
                            <input type="hidden" value="@loggedInEmployee.EmployeeId" name="employeeId" />
                            <input type="hidden" value="@loggedInEmployee.FirstName" name="firstName" />
                            <input type="hidden" value="@loggedInEmployee.LastName" name="lastName" />
                            <button class="btn btn-primary m-1" type="submit">Assign myself to this ticket</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
